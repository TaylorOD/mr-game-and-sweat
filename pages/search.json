---
layout: null
permalink: "/search.json"
sitemap: false
---
[{% for p in site.posts %}{% assign is_guide = false %}{% if p.categories contains 'guide' %}{% assign is_guide = true %}{% endif %}{% if p.score_overall or is_guide %}{% unless first_done %}{% assign first_done = true %}{% else %},{% endunless %}{"url":{{ p.url | absolute_url | jsonify }},"text":{{ p.content | strip_html | normalize_whitespace | jsonify }}{% if is_guide %},"guide":true,"title":{{ p.title | jsonify }},"excerpt":{{ p.excerpt | strip_html | strip | truncatewords: 18 | jsonify }}{% endif %}}{% endif %}{% endfor %}]
